{
  "name": "tschetschenien-edit",
  "version": "1.0.0",
  "private": true,
  "description": "Schnelles Geschichts-Edit (9:16) über tschetschenische Geschichte und Krieger, geschnitten auf einen Nasheed, gebaut mit Remotion",
