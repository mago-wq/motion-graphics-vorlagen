{
  "name": "quran-geduld",
  "version": "1.0.0",
  "private": true,
  "description": "Rezitation al-Baqara 2:152–154 mit deutscher Übersetzung und bewegten, leuchtenden Piktogramm-Figuren (9:16), gebaut mit Remotion",
  "scripts": {
    "render": "bash scripts/render.sh",
    "stills": "bash scripts/render-stills.sh",
