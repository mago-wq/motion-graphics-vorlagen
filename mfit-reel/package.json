{
  "name": "mfit-reel",
  "version": "1.0.0",
  "private": true,
  "description": "35-Sekunden-Instagram-Reel (9:16) für MFit Smart, gebaut mit Remotion",
  "scripts": {
    "studio": "remotion studio",
    "soundtrack": "python3 scripts/make_soundtrack.py",
    "render": "bash scripts/render.sh",
    "render:4k": "bash scripts/render.sh --4k",
    "stills": "bash scripts/render-stills.sh",
    "check": "python3 scripts/check_video.py",
    "check:4k": "python3 scripts/check_video.py out/mfit-reel-4k.mp4",
    "assets": "python3 scripts/prepare_assets.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
