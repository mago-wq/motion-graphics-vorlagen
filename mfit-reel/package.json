{
  "name": "mfit-reel",
  "version": "1.0.0",
  "private": true,
  "description": "35-Sekunden-Instagram-Reel (9:16) für MFit Smart, gebaut mit Remotion",
  "scripts": {
    "studio": "remotion studio",
    "soundtrack": "python3 scripts/make_soundtrack.py",
    "render": "bash scripts/render.sh",
    "render:4k": "bash scripts/render.sh --4k",
    "stills": "bash scripts/render-stills.sh",
    "check": "python3 scripts/check_video.py",
    "check:4k": "python3 scripts/check_video.py out/mfit-reel-4k.mp4",
    "assets": "python3 scripts/prepare_assets.py",
    "typecheck": "tsc --noEmit",
    "figuren": "bash scripts/figuren.sh",
    "vergleich": "bash scripts/figuren.sh && remotion render FigurenVergleich out/figuren-vergleich.mp4 --crf=16",
    "sound:film": "python3 scripts/make_film_sound.py",
    "render:film": "bash scripts/render-film.sh",
    "render:film:4k": "bash scripts/render-film.sh --4k",
    "check:film": "python3 scripts/check_video.py out/mfit-film.mp4",
    "check:film:4k": "python3 scripts/check_video.py out/mfit-film-4k.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "lottie-web": "5.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
